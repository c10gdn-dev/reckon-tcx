# Calibration corpus — real GPS traces. A raw TCX is a precise record of where
# you live and when you leave the house. Never commit these.
training-data/*
!training-data/.gitkeep
!training-data/README.md

# Local Claude Code settings and working notes.
# Note: the usual convention is to COMMIT CLAUDE.md so it is shared and
# versioned with the code, and to ignore only .claude/. It is excluded here as a
# deliberate choice: it holds candid internal notes aimed at a coding agent
# rather than at a reader of this repository.
.claude/
CLAUDE.md

# The implementation plan and calibration record. Excluded for the same reason
# as CLAUDE.md: it is a working document, and its calibration sections describe
# specific outings — routes, timings, who was wearing what — in enough detail to
# say more about a person's movements than a specification needs to. The source
# cites its section numbers throughout; see the note in ARCHITECTURE.md.
PLAN.md

# Credentials and local config
.env
*.pem
terraform.tfvars
backend.tf
.terraform/
*.tfstate
*.tfstate.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Test and coverage artefacts
.pytest_cache/
.ruff_cache/
.mutmut-cache
mutants/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mutmut-cache
mutants/

# Editor and OS
.DS_Store
.idea/
.vscode/

# Credentials. The OAuth client secret Google Cloud hands you, and the store
# holding live refresh tokens. Neither is ever committed; both are 0600 on disk.
client_secret*.json
*credentials*.json
store.json
.reckon/
