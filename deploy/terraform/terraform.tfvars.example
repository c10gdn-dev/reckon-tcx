# Copy to terraform.tfvars and edit. Nothing here is secret; the five secrets go
# into SSM by hand after the first apply, so no plaintext enters Terraform state.

region = "eu-west-2"
name   = "reckon"

# Leave empty to create the alarm topic without a subscription.
alarm_email = "you@example.com"

log_retention_days     = 14
worker_timeout_seconds = 60

# Which Google OAuth client this deployment authenticates against.
#
#   "published"  no heart rate, no maintenance. The default.
#   "testing"    an unpublished client: Relative Effort works, and the login
#                expires every seven days and must be renewed by hand.
#
# Named for the client's publishing status because that is what you can check —
# the Audience page in the Cloud console says "Testing" or "In production".
# google_profile = "testing"
